#!/usr/bin/env sh
#
# pre-push: run test suites and frontend build verification before pushing.
# Install: make install-hooks
# Bypass:  git push --no-verify
#
set -eu

failed=0

# ── Backend ──────────────────────────────────────────────────────────────────
if command -v go >/dev/null 2>&1 && command -v make >/dev/null 2>&1; then
	echo "== Backend lint =="
	if ! make backend-lint ; then
		failed=1
	fi

	echo "== Backend tests =="
	if ! make backend-test ; then
		failed=1
	fi

	echo "== Swagger validation =="
	if ! make swagger-check ; then
		failed=1
	fi
else
	echo "== Backend lint, tests, and swagger validation (skipped: go or make not found) =="
fi

# ── Frontend ─────────────────────────────────────────────────────────────────
if [ -f frontend/package.json ] && command -v make >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
	echo "== Frontend lint =="
	if ! make frontend-lint ; then
		failed=1
	fi

	echo "== Frontend tests =="
	if ! make frontend-test ; then
		failed=1
	fi

	echo "== Frontend build =="
	if ! make frontend-build ; then
		failed=1
	fi
else
	echo "== Frontend checks (skipped: make/npm not found or no package.json) =="
fi

# ── Result ───────────────────────────────────────────────────────────────────
if [ "$failed" -ne 0 ]; then
	echo "" >&2
	echo "Pre-push checks FAILED. Fix issues above or use --no-verify to bypass." >&2
	exit 1
fi

echo "Pre-push checks passed."
