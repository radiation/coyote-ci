{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespace", "controlPlaneNamespace", "images", "serviceAccounts", "cloudSql", "secrets", "storage", "cloudBuild", "worker"],
  "properties": {
    "namespace": {"type": "string", "maxLength": 63, "pattern": "^(|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$"},
    "gke": {"type": "object", "required": ["enabled", "secretManagerCSI", "workloadIdentity"], "properties": {"enabled": {"type": "boolean"}, "secretManagerCSI": {"$ref": "#/definitions/switch"}, "workloadIdentity": {"$ref": "#/definitions/switch"}}},
    "controlPlaneNamespace": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "allowSharedControlPlaneNamespace": {"type": "boolean"},
    "images": {"type": "object", "required": ["worker", "cloudSqlProxy"], "properties": {"worker": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"}, "cloudSqlProxy": {"type": "string", "minLength": 1}}},
    "release": {"type": "object", "properties": {"version": {"type": "string"}, "channel": {"type": "string", "enum": ["", "latest", "stable"]}, "manifestDigest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}}},
    "serviceAccounts": {"type": "object", "required": ["worker", "helper", "server"], "properties": {"worker": {"$ref": "#/definitions/account"}, "helper": {"$ref": "#/definitions/account"}, "server": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}}},
    "cloudSql": {"type": "object", "required": ["enabled", "connectionName"], "properties": {"enabled": {"type": "boolean"}, "connectionName": {"type": "string"}}},
    "secrets": {"type": "object", "required": ["existingSecrets"], "properties": {"project": {"type": "string"}, "databaseUrl": {"type": "string"}, "existingSecrets": {"type": "object", "additionalProperties": false, "required": ["databaseUrl"], "properties": {"databaseUrl": {"$ref": "#/definitions/secretRef"}}}}},
    "storage": {"type": "object", "required": ["provider", "artifacts"], "properties": {"provider": {"enum": ["filesystem", "gcs"]}, "project": {"type": "string"}, "artifacts": {"type": "object", "properties": {"bucket": {"type": "string"}, "strict": {"type": "boolean"}}}}},
    "cloudBuild": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "project": {"type": "string"}, "location": {"type": "string"}, "runtimeServiceAccount": {"type": "string"}, "artifactRegistryRepository": {"type": "string"}, "source": {"type": "object", "properties": {"bucket": {"type": "string"}, "includePrefix": {"type": "boolean"}}}}},
    "worker": {"type": "object", "required": ["name", "configMapName", "databaseSecretProviderClass", "replicas", "maxInFlightJobs"], "properties": {"name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "configMapName": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "databaseSecretProviderClass": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "internalAPIURL": {"type": "string", "pattern": "^(|https?://.+)$"}, "helperImage": {"type": "string", "pattern": "^(|.+)$"}, "legacyEnvironmentLayout": {"type": "boolean"}, "legacyCloudSqlProxyResources": {"type": "object"}, "replicas": {"type": "integer", "minimum": 0}, "replicasManagedExternally": {"type": "boolean"}, "maxInFlightJobs": {"type": "integer", "minimum": 1}}}
  },
  "allOf": [{"properties": {"worker": {"properties": {"extraEnvSecrets": {"type": "object", "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"}, "additionalProperties": {"$ref": "#/definitions/secretRef"}}}}}}],
  "definitions": {
    "switch": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "account": {"type": "object", "required": ["name", "annotations"], "properties": {"name": {"type": "string", "minLength": 1}, "gsaEmail": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "secretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string", "maxLength": 253, "pattern": "^(|[a-z0-9]([a-z0-9.-]*[a-z0-9])?)$"}, "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]*$"}}}
  }
}
