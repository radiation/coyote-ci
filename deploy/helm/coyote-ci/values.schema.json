{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespace", "executionNamespace", "images", "serviceAccounts", "cloudSql", "secrets", "storage", "auth"],
  "properties": {
    "namespace": {"type": "string", "maxLength": 63, "pattern": "^(|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$"},
    "gke": {"$ref": "#/definitions/gke"},
    "executionNamespace": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "allowSharedExecutionNamespace": {"type": "boolean"},
    "rbac": {"type": "object", "properties": {"tokenReviewNameOverride": {"type": "string", "maxLength": 63, "pattern": "^(|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$"}}},
    "images": {
      "type": "object",
      "required": ["server", "frontend", "migrate", "cloudSqlProxy"],
      "properties": {
        "server": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"},
        "frontend": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"},
        "migrate": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"},
        "mcp": {"type": "string"},
        "cloudSqlProxy": {"type": "string", "minLength": 1}
      }
    },
    "release": {"type": "object", "properties": {"version": {"type": "string"}, "channel": {"type": "string", "enum": ["", "latest", "stable"]}, "manifestDigest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}}},
    "serviceAccounts": {"type": "object", "required": ["server", "migrate", "mcp"], "properties": {"server": {"$ref": "#/definitions/account"}, "migrate": {"$ref": "#/definitions/account"}, "mcp": {"$ref": "#/definitions/account"}}},
    "cloudSql": {"type": "object", "required": ["enabled", "connectionName"], "properties": {"enabled": {"type": "boolean"}, "connectionName": {"type": "string"}}},
    "secrets": {
      "type": "object",
      "required": ["existingSecrets"],
      "properties": {
        "project": {"type": "string"}, "databaseUrl": {"type": "string"}, "workspaceHelperCapability": {"type": "string"}, "oidcClient": {"type": "string"}, "session": {"type": "string"},
        "existingSecrets": {"type": "object", "additionalProperties": false, "required": ["databaseUrl", "workspaceHelperCapability", "oidcClient", "session"], "properties": {"databaseUrl": {"$ref": "#/definitions/secretRef"}, "workspaceHelperCapability": {"$ref": "#/definitions/secretRef"}, "oidcClient": {"$ref": "#/definitions/secretRef"}, "session": {"$ref": "#/definitions/secretRef"}}}
      }
    },
    "storage": {
      "type": "object", "required": ["provider", "filesystem"],
      "properties": {
        "provider": {"enum": ["filesystem", "gcs"]},
        "project": {"type": "string"},
        "artifacts": {"$ref": "#/definitions/bucket"}, "cache": {"$ref": "#/definitions/bucket"}, "workspaceRevisions": {"$ref": "#/definitions/bucket"},
        "filesystem": {
          "type": "object", "required": ["existingClaim", "size", "accessModes", "mountPath", "securityContext"],
          "properties": {
            "existingClaim": {"type": "string", "maxLength": 253, "pattern": "^(|[a-z0-9]([a-z0-9.-]*[a-z0-9])?)$"},
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
            "storageClassName": {"type": ["string", "null"]},
            "accessModes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod"]}},
            "mountPath": {"type": "string", "pattern": "^/[^/]+(/[^/]+)*$"},
            "securityContext": {"type": "object", "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup"], "properties": {"runAsNonRoot": {"const": true}, "runAsUser": {"type": "integer", "minimum": 1}, "runAsGroup": {"type": "integer", "minimum": 1}, "fsGroup": {"type": "integer", "minimum": 1}, "fsGroupChangePolicy": {"enum": ["OnRootMismatch", "Always"]}}}
          }
        }
      }
    },
    "auth": {"type": "object", "required": ["mode", "bootstrapAdminEmails", "oidc", "publicURL"], "properties": {"mode": {"type": "string", "enum": ["oidc"]}, "bootstrapAdminEmails": {"type": "string", "minLength": 1}, "publicURL": {"type": "string", "pattern": "^https://"}, "oidc": {"type": "object", "required": ["issuerURL", "clientID", "redirectURL"], "properties": {"issuerURL": {"type": "string", "pattern": "^https://"}, "clientID": {"type": "string", "minLength": 1}, "redirectURL": {"type": "string", "pattern": "^https://"}}}}},
    "server": {"type": "object", "properties": {"extraEnvSecrets": {"$ref": "#/definitions/envSecrets"}, "replicas": {"type": "integer", "minimum": 0}, "replicasManagedExternally": {"type": "boolean"}}},
    "frontend": {"type": "object", "properties": {"replicas": {"type": "integer", "minimum": 0}, "replicasManagedExternally": {"type": "boolean"}}},
    "migration": {
      "type": "object",
      "properties": {
        "render": {"type": "boolean"},
        "runID": {"type": "string", "maxLength": 48, "pattern": "^(|[a-z0-9]([a-z0-9-]*[a-z0-9])?)$"}
      }
    },
    "mcp": {
      "type": "object",
      "required": ["enabled", "replicas", "replicasManagedExternally", "terminationGracePeriodSeconds", "service", "resources", "auth"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 0},
        "replicasManagedExternally": {"type": "boolean"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
        "service": {"type": "object", "required": ["port"], "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
        "resources": {"type": "object"},
        "auth": {"type": "object", "required": ["allowedOrigins", "allowDisabledAuth"], "properties": {"allowedOrigins": {"type": "array", "items": {"type": "string", "minLength": 1}}, "omitEmptyAllowedOrigins": {"type": "boolean"}, "allowDisabledAuth": {"const": false}}}
      }
    },
    "gateway": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "hostname": {"type": "string", "pattern": "^(|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+)$"}}}
  },
  "allOf": [
    {
      "if": {"properties": {"gateway": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "gateway": {
            "required": ["hostname", "addressName", "certificateMap"],
            "properties": {
              "hostname": {"minLength": 1},
              "addressName": {"minLength": 1},
              "certificateMap": {"minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mcp": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "images": {
            "required": ["mcp"],
            "properties": {
              "mcp": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"}
            }
          },
          "serviceAccounts": {
            "required": ["mcp"],
            "properties": {
              "mcp": {
                "required": ["name"],
                "properties": {
                  "name": {"minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "gke": {"type": "object", "required": ["enabled", "secretManagerCSI", "workloadIdentity"], "properties": {"enabled": {"type": "boolean"}, "secretManagerCSI": {"$ref": "#/definitions/switch"}, "workloadIdentity": {"$ref": "#/definitions/switch"}}},
    "switch": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "account": {"type": "object", "required": ["name", "annotations"], "properties": {"name": {"type": "string", "minLength": 1}, "gsaEmail": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "bucket": {"type": "object", "properties": {"bucket": {"type": "string"}, "prefix": {"type": "string"}}},
    "secretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string", "maxLength": 253, "pattern": "^(|[a-z0-9]([a-z0-9.-]*[a-z0-9])?)$"}, "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]*$"}}},
    "envSecrets": {"type": "object", "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"}, "additionalProperties": {"$ref": "#/definitions/secretRef"}}
  }
}
