{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespace", "executionNamespace", "images", "serviceAccounts", "cloudSql", "secrets", "storage", "auth"],
  "properties": {
    "namespace": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "executionNamespace": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "allowSharedExecutionNamespace": {"type": "boolean"},
    "images": {
      "type": "object",
      "required": ["server", "frontend", "migrate", "cloudSqlProxy"],
      "properties": {
        "server": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"},
        "frontend": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"},
        "migrate": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"},
        "mcp": {"type": "string"},
        "cloudSqlProxy": {"type": "string", "minLength": 1}
      }
    },
    "release": {"type": "object", "properties": {"version": {"type": "string"}, "channel": {"type": "string", "enum": ["", "latest", "stable"]}, "manifestDigest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}}},
    "serviceAccounts": {"type": "object", "required": ["server", "migrate"], "properties": {"server": {"type": "object", "required": ["gsaEmail"], "properties": {"gsaEmail": {"type": "string", "minLength": 1}}}, "migrate": {"type": "object", "required": ["gsaEmail"], "properties": {"gsaEmail": {"type": "string", "minLength": 1}}}, "mcp": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1}, "gsaEmail": {"type": "string"}}}}},
    "cloudSql": {"type": "object", "required": ["connectionName"], "properties": {"connectionName": {"type": "string", "minLength": 1}}},
    "secrets": {"type": "object", "required": ["project", "databaseUrl", "workspaceHelperCapability", "oidcClient", "session"], "properties": {"project": {"type": "string", "minLength": 1}, "databaseUrl": {"type": "string", "minLength": 1}, "workspaceHelperCapability": {"type": "string", "minLength": 1}, "oidcClient": {"type": "string", "minLength": 1}, "session": {"type": "string", "minLength": 1}}},
    "storage": {"type": "object", "required": ["project", "artifacts", "cache", "workspaceRevisions"], "properties": {"project": {"type": "string", "minLength": 1}, "artifacts": {"type": "object", "required": ["bucket"], "properties": {"bucket": {"type": "string", "minLength": 1}}}, "cache": {"type": "object", "required": ["bucket"], "properties": {"bucket": {"type": "string", "minLength": 1}}}, "workspaceRevisions": {"type": "object", "required": ["bucket"], "properties": {"bucket": {"type": "string", "minLength": 1}}}}},
    "auth": {"type": "object", "required": ["mode", "bootstrapAdminEmails", "oidc", "publicURL"], "properties": {"mode": {"type": "string", "enum": ["oidc"]}, "bootstrapAdminEmails": {"type": "string", "minLength": 1}, "publicURL": {"type": "string", "pattern": "^https://"}, "oidc": {"type": "object", "required": ["issuerURL", "clientID", "redirectURL"], "properties": {"issuerURL": {"type": "string", "pattern": "^https://"}, "clientID": {"type": "string", "minLength": 1}, "redirectURL": {"type": "string", "pattern": "^https://"}}}}},
    "server": {"type": "object", "properties": {"replicas": {"type": "integer", "minimum": 0}, "replicasManagedExternally": {"type": "boolean"}}},
    "frontend": {"type": "object", "properties": {"replicas": {"type": "integer", "minimum": 0}, "replicasManagedExternally": {"type": "boolean"}}},
    "migration": {
      "type": "object",
      "properties": {
        "render": {"type": "boolean"},
        "runID": {"type": "string", "maxLength": 48, "pattern": "^(|[a-z0-9]([a-z0-9-]*[a-z0-9])?)$"}
      }
    },
    "mcp": {
      "type": "object",
      "required": ["enabled", "replicas", "replicasManagedExternally", "terminationGracePeriodSeconds", "service", "resources", "auth"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 0},
        "replicasManagedExternally": {"type": "boolean"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
        "service": {"type": "object", "required": ["port"], "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
        "resources": {"type": "object"},
        "auth": {"type": "object", "required": ["allowedOrigins", "allowDisabledAuth"], "properties": {"allowedOrigins": {"type": "array", "items": {"type": "string", "minLength": 1}}, "allowDisabledAuth": {"const": false}}}
      }
    },
    "gateway": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "hostname": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"}}}
  },
  "allOf": [
    {
      "if": {"properties": {"gateway": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "gateway": {
            "required": ["hostname", "addressName", "certificateMap"],
            "properties": {
              "hostname": {"minLength": 1},
              "addressName": {"minLength": 1},
              "certificateMap": {"minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mcp": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "images": {
            "required": ["mcp"],
            "properties": {
              "mcp": {"type": "string", "pattern": ".+@sha256:[a-f0-9]{64}$"}
            }
          },
          "serviceAccounts": {
            "required": ["mcp"],
            "properties": {
              "mcp": {
                "required": ["name", "gsaEmail"],
                "properties": {
                  "name": {"minLength": 1},
                  "gsaEmail": {"minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  ]
}
