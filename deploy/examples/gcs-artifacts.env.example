# Artifact blob storage on GCS (set for BOTH backend and worker)

# Store selection
ARTIFACT_STORAGE_PROVIDER=gcs
ARTIFACT_STORAGE_STRICT=true

# GCS configuration
ARTIFACT_GCS_BUCKET=coyote-artifacts-prod
ARTIFACT_GCS_PREFIX=coyote-ci
# ARTIFACT_GCS_PROJECT=optional-project-id

# Kubernetes cache helpers use the server-owned cache store. These settings are
# required when COYOTE_KUBERNETES_CACHE_HELPER_ENABLED=true.
COYOTE_KUBERNETES_CACHE_HELPER_ENABLED=true
WORKER_CACHE_STORAGE_PROVIDER=gcs
WORKER_CACHE_STORAGE_STRICT=true
WORKER_CACHE_GCS_BUCKET=coyote-cache-prod
WORKER_CACHE_GCS_PREFIX=coyote-ci/cache
# WORKER_CACHE_GCS_PROJECT=optional-project-id

# Credentials should come from runtime identity/secret injection,
# not hardcoded environment values committed to git.
