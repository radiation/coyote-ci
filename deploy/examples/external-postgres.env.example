# External Postgres runtime configuration example
# Copy values into your deployment environment for BOTH backend and worker.

# Preferred single DSN/URL for managed Postgres
DATABASE_URL=postgres://coyote_app:replace-me@db.example.internal:5432/coyote_ci?sslmode=require

# Optional pool tuning
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Required application secrets
GITHUB_WEBHOOK_SECRET=replace-me

# Identity/auth foundation. Use header only behind a trusted reverse proxy that
# injects X-Coyote-User-Email and X-Coyote-User-Name. Use oidc for native login.
AUTH_MODE=disabled
BOOTSTRAP_ADMIN_EMAILS=
# OIDC_ISSUER_URL=https://issuer.example.com
# OIDC_CLIENT_ID=coyote-ci
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URL=https://ci.example.com/auth/callback
# OIDC_SCOPES=openid email profile
# SESSION_SECRET=replace-with-random-secret
# SESSION_COOKIE_NAME=coyote_session
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=lax
